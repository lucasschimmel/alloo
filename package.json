{
  "name": "alloo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter \"@alloo/web\" --filter \"@alloo/landing\" dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "build": "bun run --sequential --filter \"@alloo/web\" --filter \"@alloo/landing\" build",
    "preview": "bun run --cwd apps/web preview",
    "preview:landing": "bun run --cwd apps/landing preview",
    "typecheck": "tsc --noEmit && bun run --sequential --workspaces --if-present typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "playwright test",
    "convex": "convex dev",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test:mutation": "bun scripts/check-critical-mutations.ts",
    "release:check": "bun scripts/check-release.ts",
    "deploy": "bun run release:check && bun run --sequential --filter \"@alloo/web\" --filter \"@alloo/landing\" deploy",
    "deploy:dry-run": "bun run build && bun run --sequential --filter \"@alloo/web\" --filter \"@alloo/landing\" deploy:dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "convex-test": "0.0.62",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "convex": "1.46.0",
    "pngjs": "7.0.0",
    "@alloo/shared": "workspace:*"
  }
}
