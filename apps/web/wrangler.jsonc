{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alloo-web",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
